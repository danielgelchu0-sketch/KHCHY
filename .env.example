# ==============================================================================
# HKHC Community Discussion Platform - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit real secret keys or production passwords to version control.
# ==============================================================================

# Security
SECRET_KEY=change-this-to-a-super-secret-unpredictable-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourusername.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://yourusername.pythonanywhere.com

# Database (Leave DB_ENGINE empty or unset to use SQLite in local development)
# For PostgreSQL (e.g. PythonAnywhere or production):
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hkhc_community_db
DB_USER=hkhc_user
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432
# Or specify full DATABASE_URL:
# DATABASE_URL=postgres://hkhc_user:your_secure_db_password@localhost:5432/hkhc_community_db

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_sendgrid_or_smtp_password
DEFAULT_FROM_EMAIL=HKHC Community <noreply@community.hkhc.org>

# Security Settings (Set to True in production with HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
