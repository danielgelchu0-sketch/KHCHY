msgid "Amharic"
msgstr "አማርኛ"

# Brand & General Interface
msgid "HKHC Community"
msgstr "የHKHC ማህበረሰብ"

msgid "Church Community Discussion"
msgstr "የቤተክርስቲያን ማህበረሰብ ውይይት"

msgid "Safe, Honest, Biblical Fellowship"
msgstr "አስተማማኝ፣ ቅንና መጽሐፍ ቅዱሳዊ ህብረት"

msgid "A safe, moderated church community space for honest questions, biblical fellowship, and thoughtful discussion."
msgstr "ለቅን ጥያቄዎች፣ ለመጽሐፍ ቅዱሳዊ ህብረት እና ለአሳቢ ውይይት የተዘጋጀ የተጠበቀ የቤተክርስቲያን ማህበረሰብ መድረክ።"

msgid "Home"
msgstr "መነሻ"

msgid "Main Navigation"
msgstr "ዋና ማውጫ"

msgid "Topics & Rooms"
msgstr "የውይይት መድረኮች"

msgid "Guidelines"
msgstr "መመሪያዎች"

msgid "Privacy & Safety"
msgstr "ደህንነትና ግላዊነት"

msgid "Moderator Hub"
msgstr "የአወያዮች ማዕከል"

msgid "Search questions..."
msgstr "ጥያቄዎችን ይፈልጉ..."

msgid "Search discussions"
msgstr "ውይይቶችን ይፈልጉ"

msgid "Language Selector"
msgstr "ቋንቋ ይምረጡ"

msgid "Notifications"
msgstr "ማሳወቂያዎች"

msgid "Mod"
msgstr "አወያይ"

msgid "Settings"
msgstr "ቅንብሮች"

msgid "Log out"
msgstr "ይውጡ"

msgid "Log in"
msgstr "ይግቡ"

msgid "Join Community"
msgstr "ማህበረሰቡን ይቀላቀሉ"

# Landing Page
msgid "Welcome"
msgstr "እንኳን ደህና መጡ"

msgid "A Protected Space for Honest Dialogue"
msgstr "ለቅን እና ግልጽ ውይይት የተዘጋጀ የተጠበቀ መድረክ"

msgid "Ask difficult questions about faith, struggles, and life without social fear."
msgstr "ስለ እምነት፣ ፈተናዎች እና የሕይወት ውጣ ውረዶች ያለ ማኅበራዊ ስጋት በግልጽ ይጠይቁ።"

msgid "Growing in Christ means wrestling with hard questions. We provide our church family—teens, youths, and adults—a psychologically safe, structured, and carefully moderated community platform where you can choose to participate under your identity or post anonymously."
msgstr "በክርስቶስ ማደግ ውስብስብ ጥያቄዎችን በግልጽ መጋፈጥን ይጠይቃል። ለቤተክርስቲያናችን ቤተሰቦች — ታዳጊዎች፣ ወጣቶችና ጎልማሶች — በስምዎ ወይም ማንነትዎን ሳይገልጹ (በሚስጥር) የሚሳተፉበት አስተማማኝ፣ ሥርዓት ያለውና ኃላፊነት የተሞላበት የውይይት መድረክ አዘጋጅተናል።"

msgid "Join Our Community"
msgstr "ማህበረሰቡን ይቀላቀሉ"

msgid "Browse Discussion Rooms"
msgstr "የውይይት መድረኮችን ይመልከቱ"

msgid "Built on Care, Privacy, and Biblical Accountability"
msgstr "በፍቅር፣ በሚስጥራዊነት እና በመጽሐፍ ቅዱሳዊ ተጠያቂነት ላይ የተመሠረተ"

msgid "True Post-by-Post Privacy"
msgstr "በእያንዳንዱ ጽሑፍ የሚመረጥ ሙሉ ሚስጥራዊነት"

msgid "Choose before submitting every single question or reply whether to share your name or post anonymously. Your anonymity choice is completely flexible and never permanent."
msgstr "እያንዳንዱን ጥያቄ ወይም ምላሽ ከማስገባትዎ በፊት ስምዎ እንዲታይ ወይም ማንነትዎ እንዳይታወቅ መምረጥ ይችላሉ። ይህ ምርጫ ለእያንዳንዱ ጽሑፍ የሚደረግ እንጂ ቋሚ አይደለም።"

msgid "First-Class Safety & Moderation"
msgstr "አስተማማኝ ደህንነት እና ኃላፊነት የተሞላበት ክትትል"

msgid "Our church moderators review community reports, prevent bullying, and safeguard members while upholding a safe space for vulnerable sharing."
msgstr "የቤተክርስቲያናችን አወያዮች የሚቀርቡ ጥቆማዎችን ይመረምራሉ፣ ትንኮሳን ይከላከላሉ፣ እንዲሁም ግልጽ እና ታማኝ ውይይት እንዲኖር የአባላትን ደህንነት ይጠብቃሉ።"

msgid "Structured, Thoughtful Dialogue"
msgstr "ሥርዓት ያለውና አሳቢ ውይይት"

msgid "Organized by specific topics and threaded questions rather than chaotic chat streams, giving questions the deep, prayerful reflection they deserve."
msgstr "ውይይቶች ባልተደራጀ የውይይት ፍሰት ፋንታ በርዕስና በቅደም ተከተል ስለሚደራጁ፣ ለቀረቡት ጥያቄዎች በቂና በጸሎት የተሞላ ምላሽ እንዲሰጥ ያስችላል።"

msgid "Discussion Rooms"
msgstr "የውይይት ክፍሎች"

msgid "Explore conversations across dedicated topic areas"
msgstr "በተዘጋጁ የተለያዩ ርዕሶች ዙሪያ ያሉ ውይይቶችን ይመልከቱ"

msgid "View All Rooms"
msgstr "ሁሉንም ክፍሎች ይመልከቱ"

msgid "Enter Room"
msgstr "ወደ ክፍሉ ይግቡ"

msgid "questions"
msgstr "ጥያቄዎች"

msgid "answers"
msgstr "ምላሾች"

msgid "replies"
msgstr "ምላሾች"

msgid "views"
msgstr "እይታዎች"

msgid "view"
msgstr "እይታ"

# Discussion Topics
msgid "Faith & Spiritual Life"
msgstr "እምነትና መንፈሳዊ ሕይወት"

msgid "Questions about prayer, spiritual doubts, personal devotion, hearing God's voice, and growing in Christ."
msgstr "ስለ ጸሎት፣ መንፈሳዊ ጥርጣሬዎች፣ የግል የጸሎት ሕይወት፣ የእግዚአብሔርን ድምጽ ስለመስማትና በክርስቶስ ስለማደግ የሚነሱ ጥያቄዎች።"

msgid "Youth Questions"
msgstr "የወጣቶች ጥያቄዎች"

msgid "A dedicated, supportive room for teens, youths, and young adults tackling peer pressure, identity, and life choices."
msgstr "ለታዳጊዎች፣ ወጣቶችና ወጣት ጎልማሶች ስለ ጓደኛ ተፅዕኖ፣ ማንነትና የሕይወት ውሳኔዎች በግልጽ የሚወያዩበት የተዘጋጀ ክፍል።"

msgid "Mental & Emotional Struggles"
msgstr "አእምሮአዊና ስሜታዊ ፈተናዎች"

msgid "Safe, compassionate discussions regarding anxiety, depression, burnout, grief, loneliness, and emotional well-being."
msgstr "ስለ ጭንቀት፣ ድብርት፣ ድካም፣ ሐዘን፣ ብቸኝነት እና ስሜታዊ ደህንነት ርኅራኄ የተሞላበት አስተማማኝ ውይይት።"

msgid "Sexuality & Boundaries"
msgstr "ጾታዊነትና ክርስቲያናዊ ወሰኖች"

msgid "Confidential, biblical, and sensitive dialogue on purity, dating boundaries, temptations, attraction, and healing."
msgstr "ስለ ንጽሕና፣ የፍቅር ጓደኝነት ወሰኖች፣ ፈተናዎች፣ ስሜቶችና ፈውስ በሚስጥርና በመጽሐፍ ቅዱሳዊ አመለካከት የሚደረግ ውይይት።"

msgid "Relationships & Dating"
msgstr "ግንኙነትና የፍቅር ጓደኝነት"

msgid "Navigating friendships, godly dating, courtship, heartbreaks, and healthy relationship patterns."
msgstr "ስለ እውነተኛ ጓደኝነት፣ እግዚአብሔርን ስለሚያከብር የፍቅር ግንኙነት፣ የመለያየት ፈተናዎችና ጤናማ ግንኙነቶች የሚደረግ ውይይት።"

msgid "Marriage & Family"
msgstr "ጋብቻና የቤተሰብ ሕይወት"

msgid "Couples, parents, and families discussing marriage challenges, parenting, communication, and home life."
msgstr "ስለ ባለትዳሮችና ወላጆች የጋብቻ ፈተናዎች፣ ልጆችን ማሳደግ፣ ግንኙነትና የቤተሰብ ሕይወት የሚደረግ ውይይት።"

msgid "Bible Questions & Theology"
msgstr "መጽሐፍ ቅዱሳዊ ጥያቄዎችና ትምህርተ መለኮት"

msgid "Scripture interpretation, difficult biblical passages, theology questions, and apologetics."
msgstr "ስለ ቅዱሳት መጻሕፍት ማብራሪያ፣ አስቸጋሪ የመጽሐፍ ቅዱስ ክፍሎች፣ የነገረ መለኮት ጥያቄዎችና እምነትን መከላከል (አፖሎጄቲክስ)።"

msgid "Education & Career"
msgstr "ትምህርትና የሥራ ሕይወት"

msgid "School, college decisions, workplace integrity, career discernment, and balancing work with Christian faith."
msgstr "ስለ ትምህርት፣ የዩኒቨርሲቲ ውሳኔዎች፣ በሥራ ቦታ ስለሚኖር ታማኝነት፣ የሙያ ምርጫና እምነትን ከሥራ ጋር ስለማጣጣም።"

msgid "Church Life & Community"
msgstr "የቤተክርስቲያን ሕይወትና ህብረት"

msgid "Ministry involvement, serving in church, resolving interpersonal friction, and building authentic community fellowship."
msgstr "ስለ አገልግሎት ተሳትፎ፣ በቤተክርስቲያን ስለማገልገል፣ አለመግባባቶችን ስለመፍታትና እውነተኛ የወንድማማችነት ህብረትን ስለመገንባት።"

msgid "General Discussion"
msgstr "አጠቃላይ ውይይት"

msgid "Open fellowship, encouraging testimonies, books, hobbies, and everyday community conversations."
msgstr "አጠቃላይ ህብረት፣ የሚያበረታቱ ምስክርነቶች፣ መጻሕፍት፣ እና የዕለት ተዕለት የማህበረሰብ ውይይቶች።"

# Discussion Lists and Views
msgid "Discussion Topics & Rooms"
msgstr "የውይይት ርዕሶችና መድረኮች"

msgid "Choose a dedicated topic room to explore discussions or ask sensitive questions in a safe environment."
msgstr "ውይይቶችን ለመከታተል ወይም ሚስጥራዊ ጥያቄዎችን በተጠበቀ ሁኔታ ለመጠየቅ ከተዘጋጁት ክፍሎች አንዱን ይምረጡ።"

msgid "active threads"
msgstr "ንቁ ውይይቶች"

msgid "Recent Community Discussions"
msgstr "የቅርብ ጊዜ የማህበረሰብ ውይይቶች"

msgid "Anonymous Member"
msgstr "ማንነቱ ያልተገለጸ አባል"

msgid "Last active"
msgstr "የመጨረሻ እንቅስቃሴ"

msgid "ago"
msgstr "በፊት"

msgid "No discussions yet. Be the first to start a conversation in one of the rooms above!"
msgstr "እስካሁን ምንም ውይይት አልተጀመረም። ከላይ ካሉት ክፍሎች በአንዱ ውይይት በመክፈት የመጀመሪያው ይሁኑ!"

msgid "All Discussion Rooms"
msgstr "ሁሉም የውይይት ክፍሎች"

msgid "Ask a Question"
msgstr "ጥያቄ ያቅርቡ"

msgid "Archived Topic Room"
msgstr "ይህ ክፍል በማህደር ተቀምጧል"

msgid "Questions & Discussions"
msgstr "ጥያቄዎችና ውይይቶች"

msgid "Recent Activity"
msgstr "የቅርብ ጊዜ እንቅስቃሴ"

msgid "Newest"
msgstr "አዳዲስ"

msgid "Most Replies"
msgstr "ብዙ ምላሽ ያገኙ"

msgid "Locked"
msgstr "የተዘጋ"

msgid "Posted"
msgstr "የቀረበው"

msgid "Previous"
msgstr "ቀዳሚ"

msgid "Page"
msgstr "ገጽ"

msgid "of"
msgstr "ከ"

msgid "Next"
msgstr "ቀጣይ"

msgid "No discussions have been started in this room yet."
msgstr "በዚህ ክፍል ውስጥ እስካሁን ምንም ውይይት አልተጀመረም።"

msgid "Ask the First Question"
msgstr "የመጀመሪያውን ጥያቄ ያቅርቡ"

# Discussion Detail
msgid "Topics"
msgstr "ርዕሶች"

msgid "Moderator Author Inspection"
msgstr "የአወያይ ደራሲ ምርመራ"

