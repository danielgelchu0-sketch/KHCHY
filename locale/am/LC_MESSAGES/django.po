msgstr "ተጨማሪ ማብራሪያ"

msgid "Please explain why this content violates community guidelines."
msgstr "ይህ ይዘት የማህበረሰቡን መመሪያ እንዴት እንደሚጥስ እባክዎ ያብራሩ።"

msgid "Submit Report"
msgstr "ሪፖርቱን ላክ"

msgid "Password Reset Sent"
msgstr "የይለፍ ቃል መቀየሪያ ተልኳል"

msgid "Check Your Email"
msgstr "ኢሜይልዎን ይመልከቱ"

msgid "If an account exists with the email you entered, you will shortly receive an email with instructions for resetting your password."
msgstr "በአስገቡት ኢሜይል የተመዘገበ አካውንት ካለ፣ የይለፍ ቃልዎን ለመቀየር የሚያስችል መመሪያ የያዘ ኢሜይል በቅርቡ ይደርስዎታል።"

msgid "Return to Log In"
msgstr "ወደ መግቢያው ተመለስ"

msgid "Set New Password"
msgstr "አዲስ የይለፍ ቃል ያዘጋጁ"

msgid "Set a New Password"
msgstr "አዲስ የይለፍ ቃል ያዘጋጁ"

msgid "Please enter your new password below."
msgstr "እባክዎ አዲሱን የይለፍ ቃልዎን ከዚህ በታች ያስገቡ።"

msgid "Confirm New Password"
msgstr "አዲሱን የይለፍ ቃል ያረጋግጡ"

msgid "Change Password"
msgstr "የይለፍ ቃል ቀይር"

msgid "Password Reset Link Expired"
msgstr "የይለፍ ቃል መቀየሪያው አገናኝ ጊዜው አልፏል"

msgid "The password reset link was invalid, possibly because it has already been used or has expired."
msgstr "የይለፍ ቃል መቀየሪያው አገናኝ ልክ አይደለም፤ ምናልባት ቀደም ሲል አገልግሎት ላይ ውሏል ወይም ጊዜው አልፏል።"

msgid "Request New Reset Link"
msgstr "አዲስ የመቀየሪያ አገናኝ ይጠይቁ"

msgid "Password Reset Complete"
msgstr "የይለፍ ቃል ለውጥ ተጠናቋል"

msgid "Password Successfully Reset"
msgstr "የይለፍ ቃልዎ በተሳካ ሁኔታ ተቀይሯል"

msgid "Your password has been changed. You may now sign in using your new credentials."
msgstr "የይለፍ ቃልዎ ተቀይሯል። አሁን በአዲሱ መረጃዎ መግባት ይችላሉ።"

msgid "Bad Request (400)"
msgstr "ልክ ያልሆነ ጥያቄ (400)"

msgid "Bad Request"
msgstr "ልክ ያልሆነ ጥያቄ"

msgid "The server was unable to understand the request sent by your browser."
msgstr "አስተናጋጁ አገልጋይ አሳሽዎ የላከውን ጥያቄ መረዳት አልቻለም።"

msgid "Access Denied (403)"
msgstr "መዳረሻ ተከልክሏል (403)"

msgid "Access Restricted"
msgstr "የተገደበ መዳረሻ"

msgid "You do not have the required permissions to view this resource or perform this action. If you believe this is in error, please contact a community administrator."
msgstr "ይህን ገጽ ለማየት ወይም ይህን ተግባር ለማከናወን የሚያስፈልገው ፈቃድ የለዎትም። ስህተት ነው ብለው ካሰቡ እባክዎ የማህበረሰብ አስተዳዳሪዎችን ያነጋግሩ።"

msgid "Return to Community Home"
msgstr "ወደ ማህበረሰቡ መነሻ ገጽ ተመለስ"

msgid "Too Many Requests (429)"
msgstr "በጣም የበዙ ጥያቄዎች (429)"

msgid "Too Many Requests"
msgstr "በጣም የበዙ ጥያቄዎች"

msgid "You have submitted requests too rapidly. To protect community servers and ensure psychological safety from spam, please pause a moment before trying again."
msgstr "ጥያቄዎችን በጣም በተከታታይ ልከዋል። የአገልጋዩን ደህንነት ለመጠበቅና ከአላስፈላጊ መልእክቶች ለመከላከል እባክዎ ድጋሚ ከመሞከርዎ በፊት ጥቂት ቆይተው ይሞክሩ።"

msgid "Server Error (500)"
msgstr "የአገልጋይ ስህተት (500)"

msgid "Unexpected Server Error"
msgstr "ያልተጠበቀ የአገልጋይ ስህተት"

msgid "We encountered an unexpected issue while processing your request. Our technical team has been alerted. Please try again shortly."
msgstr "ጥያቄዎን ስናስተናግድ ያልተጠበቀ ችግር አጋጥሞናል። ለቴክኒክ ክፍላችን መልእክት ደርሷል። እባክዎ ከጥቂት ቆይታ በኋላ እንደገና ይሞክሩ።"

# User Guide & Reply Reactions
msgid "How to Use"
msgstr "የአጠቃቀም መመሪያ"

msgid "User Guide"
msgstr "የተጠቃሚ መመሪያ"

msgid "How to Use Guide"
msgstr "የአጠቃቀም መመሪያ"

msgid "New to the HKHC platform?"
msgstr "አዲስ ነዎት?"

msgid "Learn how to ask questions, post anonymously, reply, and react with Likes/Dislikes in our simple bilingual guide."
msgstr "ጥያቄዎችን እንዴት እንደሚጠይቁ፣ በሚስጥር እንደሚጽፉ፣ መልስ እንደሚሰጡና Like/Dislike እንደሚጫኑ በቀላል ባለሁለት ቋንቋ መመሪያችን ይመልከቱ።"

msgid "Read User Guide"
msgstr "መመሪያውን ያንብቡ"

msgid "Like this reply"
msgstr "ይህን መልስ ውደዱት"

msgid "Dislike this reply"
msgstr "ይህን መልስ አለመውደድ"

msgid "Log in to like this reply"
msgstr "ይህን መልስ ለመውደድ ይግቡ"

msgid "Log in to dislike this reply"
msgstr "ይህን መልስ ላለመውደድ ይግቡ"

msgid "Christian Community Fellowship and Dialogue"
msgstr "የክርስቲያን ማህበረሰብ ህብረት እና ውይይት"

msgid "Welcome to your church community discussion home. Choose a dedicated room below to explore questions, share encouragement, or post in safe biblical fellowship."
msgstr "ወደ ቤተክርስቲያን ማህበረሰብ የውይይት አዳራሽ በደህና መጡ። ጥያቄዎችን ለመጠየቅ፣ ማበረታቻዎችን ለመካፈል ወይም በመንፈሳዊ ህብረት ለመሳተፍ ከታች ከተዘረዘሩት ክፍሎች ውስጥ አንዱን ይምረጡ።"



